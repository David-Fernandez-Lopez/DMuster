REVIEW_PLAN.md
PLAN_REMEDIACION.md

# Design handoff (local reference, not versioned)
/design/

# Cursor IDE local config
.cursor/

# Dependencies
node_modules/
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/

# Production build
/build
/dist/

# Environment variables (never commit secrets)
.env
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client (regenerated via `prisma generate`)
/src/generated/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Docker local volumes
mysql_data/

# Database dumps. backup-db.sh writes outside the repository precisely so this
# rule never has to save us; it stays as a second fence for the case where
# someone points the script at a path in here on purpose.
/backups/

# Certificates
*.pem

# Test coverage
/coverage
