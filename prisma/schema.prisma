// DMuster Prisma schema.
// Datasource URL is provided by prisma.config.ts (Prisma 7 config-driven setup).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CampaignRole {
  DM
  PLAYER
}

enum Locale {
  es
  en
}

enum Theme {
  light
  dark
}

enum AvailabilityStatus {
  YES
  NO
  MAYBE
}

// Lifecycle of one (session, user) row's Google Calendar event. PENDING/FAILED
// are actionable by `processPending` (roadmap #23); SYNCED and DELETED are
// terminal until the next `enqueue*` call flips them back to PENDING.
enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  DELETED
}

// What `processPending` should do with a PENDING/FAILED row. Kept separate
// from `SyncStatus` because a failed deletion must stay distinguishable from
// a failed creation/update on retry — a single enum couldn't carry both without
// losing which operation to resume.
enum SyncOperation {
  UPSERT
  DELETE
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String
  locale             Locale    @default(es)
  // Manual light/dark override. null = follow the OS preference
  // (prefers-color-scheme). Mirrors `locale` for cross-device persistence.
  theme              Theme?
  // Opt-in for Google Calendar sync (roadmap #23), independent of having a
  // Google `Account` row — lets a user pause sync without disconnecting.
  googleSyncEnabled  Boolean   @default(false)
  // Set when Google reports the OAuth consent as revoked/expired
  // (`invalid_grant` on refresh). Surfaces a "reconnect" prompt in /profile;
  // cleared on a fresh, successful connect.
  googleSyncBrokenAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  createdCampaigns Campaign[]       @relation("CampaignCreatedBy")
  campaigns        CampaignPlayer[]
  createdHolidays  Holiday[]        @relation("HolidayCreatedBy")
  availabilities   Availability[]

  confirmedSessions     ConfirmedSession[]         @relation("SessionConfirmedBy")
  cancelledSessions     ConfirmedSession[]         @relation("SessionCancelledBy")
  sessionAttendances    ConfirmedSessionAttendee[] @relation("SessionAttendee")
  addedSessionAttendees ConfirmedSessionAttendee[] @relation("SessionAttendeeAddedBy")
  calendarEvents        SessionCalendarEvent[]

  @@map("users")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  // Two-letter chip label shown in the calendar UI (e.g. "AC", "OR").
  // Not @unique on purpose: the model is designed for future multi-group
  // support (CLAUDE.md §4), where tags are only unique within a group.
  tag         String   @db.VarChar(2)
  description String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User             @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  players   CampaignPlayer[]

  confirmedSessions ConfirmedSession[]

  @@map("campaigns")
}

model CampaignPlayer {
  campaignId String
  userId     String
  role       CampaignRole @default(PLAYER)
  createdAt  DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@map("campaign_players")
}

// Weekday dates that are eligible for play in addition to weekends.
// Weekends (Sat/Sun) are always eligible and are not stored here.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("holidays")
}

// A player's global availability for a single calendar day. The response is
// not scoped to a campaign: it applies to every campaign the player belongs
// to. YES/NO/MAYBE are all stored ("Tal vez" is a real answer). Only the
// pending state stays derived — the absence of a row for a (date, user) pair.
// For viability (roadmap #17), the "T" tier is any stored MAYBE OR a missing
// response; clearing an answer still deletes the row.
model Availability {
  id        String             @id @default(cuid())
  date      DateTime           @db.Date
  userId    String
  status    AvailabilityStatus
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@map("availabilities")
}

// A DM's confirmation that a campaign is playing on a given eligible day. Soft
// delete only: cancelling a session stamps `cancelledAt`/`cancelledById` and
// never removes the row, so cancelled attempts stay available for the Phase 2
// statistics view and for #23's Google Calendar cleanup. Named `ConfirmedSession`
// (not `Session`) to avoid colliding with the Auth.js session table.
model ConfirmedSession {
  id              String    @id @default(cuid())
  campaignId      String
  date            DateTime  @db.Date
  // Mirrors `date` while the session is active, and is set to null on cancel.
  // Exists solely to back @@unique([campaignId, activeDate]): MySQL treats NULLs
  // as distinct, so any number of cancelled rows can coexist while at most one
  // ACTIVE row per (campaign, date) is possible. Never read for business logic.
  activeDate      DateTime? @db.Date
  // "HH:MM", local wall time — no timezone math lives in the DB.
  startTime       String?   @db.VarChar(5)
  // Only meaningful together with startTime. No startTime means an all-day session.
  durationMinutes Int?
  // True when the campaign's viability on `date` was not S at confirmation time (a DM
  // override, roadmap #22). Internal only — statistics/history — a forced session looks
  // identical in the UI.
  forced          Boolean   @default(false)

  confirmedById String
  cancelledAt   DateTime?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign       Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  confirmedBy    User                       @relation("SessionConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy    User?                      @relation("SessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  attendees      ConfirmedSessionAttendee[]
  calendarEvents SessionCalendarEvent[]

  @@unique([campaignId, activeDate])
  @@index([campaignId, date])
  @@map("confirmed_sessions")
}

// Who actually plays a given confirmed session. In roadmap #21 this always
// mirrors the campaign's full membership (confirming a viable day means
// everyone plays); #22 makes the set vary via DM overrides and self-joins.
model ConfirmedSessionAttendee {
  sessionId String
  userId    String
  // Audit: the DM who added them, or null for the implicit whole-campaign set
  // written at confirmation (and later, a player's own self-join in #22).
  addedById String?
  createdAt DateTime @default(now())

  session ConfirmedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation("SessionAttendee", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?            @relation("SessionAttendeeAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([sessionId, userId])
  @@map("confirmed_session_attendees")
}

// Retry ledger and delivery record for one attendee's Google Calendar event of
// one confirmed session (roadmap #23). `enqueue*` helpers in
// calendarSyncService.ts write PENDING/FAILED rows here; `processPending` is
// the only code that calls Google and advances `status`. Kept as its own table
// (not columns on ConfirmedSessionAttendee) because a cancelled/removed
// attendee still needs a row to track deleting their event.
//
// `@@unique([sessionId, userId])` is what makes every `enqueue*` call an
// idempotent upsert instead of risking duplicate rows (and duplicate Google
// events) for the same person.
model SessionCalendarEvent {
  id            String        @id @default(cuid())
  sessionId     String
  userId        String
  // Google's event id, set once `status` first reaches SYNCED. Needed to
  // PATCH/DELETE the right event later; null before the first successful sync.
  googleEventId String?
  status        SyncStatus    @default(PENDING)
  operation     SyncOperation @default(UPSERT)
  attempts      Int           @default(0)
  lastError     String?       @db.Text
  lastAttemptAt DateTime?
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  session ConfirmedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  // Serves processPending's "oldest due PENDING/FAILED row first" query.
  @@index([status, lastAttemptAt])
  @@map("session_calendar_events")
}

// ─── Auth.js v5 adapter tables ───────────────────────────────────────────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
