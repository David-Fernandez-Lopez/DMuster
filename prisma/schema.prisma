// DMuster Prisma schema.
// Datasource URL is provided by prisma.config.ts (Prisma 7 config-driven setup).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CampaignRole {
  DM
  PLAYER
}

enum Locale {
  es
  en
}

enum ColorVision {
  protan
  deutan
  tritan
  all
}

enum Theme {
  light
  dark
}

enum AvailabilityStatus {
  YES
  NO
  MAYBE
  ONLINE
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String
  locale             Locale    @default(es)
  // Manual light/dark override. null = follow the OS preference
  // (prefers-color-scheme). Mirrors `locale` for cross-device persistence.
  theme              Theme?
  // Colour-blind palette ("Modo daltónico" in /profile): which vision type the
  // palette is tuned for, or null for the regular colours. A trait of the person,
  // not of the device, so unlike `theme` it has no cookie: the database decides,
  // and the root layout stamps it as `data-color-vision`.
  colorVision        ColorVision?
  // How many months "Mi disponibilidad" lists, the current one included. Only
  // widens the default window (at least 16 eligible days through month end),
  // never narrows it.
  availabilityHorizonMonths Int @default(2)
  // Secret in the user's personal iCalendar subscription URL
  // (`/api/calendar/<token>.ics`). Null until they generate one from /profile.
  // Stored raw, unlike one-shot tokens (invitations, password resets), because
  // the URL must be shown again; regenerating replaces it and kills the old URL.
  calendarFeedToken String? @unique @db.VarChar(64)
  // Set to revoke an account's access without deleting it. `authorize` refuses
  // to sign a disabled account in, and clearing it restores access.
  //
  // A soft flag rather than a row deletion because deleting the row is not
  // available: six foreign keys reference a user with `Restrict` (campaigns and
  // holidays created, sessions confirmed and cancelled, invitations sent and
  // accepted), so anyone who has used the app is undeletable.
  disabledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  createdCampaigns Campaign[]       @relation("CampaignCreatedBy")
  campaigns        CampaignPlayer[]
  createdHolidays  Holiday[]        @relation("HolidayCreatedBy")
  availabilities   Availability[]

  confirmedSessions     ConfirmedSession[]          @relation("SessionConfirmedBy")
  cancelledSessions     ConfirmedSession[]          @relation("SessionCancelledBy")
  sessionAttendances    ConfirmedSessionAttendee[]  @relation("SessionAttendee")
  addedSessionAttendees ConfirmedSessionAttendee[]  @relation("SessionAttendeeAddedBy")
  sentInvitations       Invitation[]                @relation("InvitationInvitedBy")
  acceptedInvitations   Invitation[]                @relation("InvitationAcceptedBy")
  passwordResetTokens   PasswordResetToken[]

  // Critical/fumble log: the rolls a user made, and the ones they entered.
  diceEvents        DiceEvent[] @relation("DiceEventPlayer")
  createdDiceEvents DiceEvent[] @relation("DiceEventCreatedBy")

  @@map("users")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  // Two-letter chip label shown in the calendar UI (e.g. "AC", "OR").
  // Not @unique on purpose: the model is designed for future multi-group
  // support (CLAUDE.md §4), where tags are only unique within a group.
  tag         String   @db.VarChar(2)
  description String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Next-session requirements (roadmap #25). `requirementsSetAt` is when a DM
  // last saved custom requirements; `null` means the default rule (every
  // member is required). They apply until the campaign's next confirmed
  // session has passed (src/lib/campaignRequirements.ts) and are ignored from
  // then on, so an expired setting needs no cleanup. `minPlayers` is how many
  // players (DMs never count) must be able to play, or `null` for no minimum.
  minPlayers        Int?
  requirementsSetAt DateTime?

  // The campaign's colour, as a slot into the palette (src/lib/campaignColor.ts).
  // Assigned automatically on creation (the smallest slot no campaign uses) and
  // editable by a DM. Unique across campaigns by the services, not the database:
  // with future multi-group support it would only be unique within a group.
  colorSlot Int @default(0)

  // The tabletop system the campaign plays (its skills and conditions are what
  // the critical/fumble log offers). Nullable: campaigns created before systems
  // existed have none until a DM picks one, and cannot log anything meanwhile.
  systemId String?

  createdBy User             @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  players   CampaignPlayer[]

  confirmedSessions ConfirmedSession[]
  invitations       Invitation[]
  arcs              CampaignArc[]
  diceEvents        DiceEvent[]
  system            RoleSystem?   @relation(fields: [systemId], references: [id], onDelete: Restrict)

  @@map("campaigns")
}

model CampaignPlayer {
  campaignId     String
  userId         String
  role           CampaignRole @default(PLAYER)
  // Marked optional by the campaign's custom requirements (roadmap #25): their
  // answer never blocks a session on its own. Ignored for DMs (always
  // required) and whenever the requirements are not in force.
  optional       Boolean      @default(false)
  // Optional for good (roadmap #25.2) — a player who comes and goes. Never
  // expires: it applies whenever the next-session requirements above are not
  // in force, and seeds their default. Ignored for DMs.
  alwaysOptional Boolean      @default(false)
  createdAt      DateTime     @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@map("campaign_players")
}

// Monday–Thursday dates that are eligible for play in addition to Fridays and
// weekends. Fridays and weekends (Fri/Sat/Sun) are always eligible and are not
// stored here.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("holidays")
}

// A player's global availability for a single calendar day. The response is
// not scoped to a campaign: it applies to every campaign the player belongs
// to. YES/NO/MAYBE/ONLINE are all stored ("Tal vez" and "Sí (Online)" are real
// answers; ONLINE means "yes, but remotely"). Only the pending state stays
// derived — the absence of a row for a (date, user) pair.
// For viability (roadmap #17), the "T" tier is any stored MAYBE OR a missing
// response; clearing an answer still deletes the row.
model Availability {
  id        String             @id @default(cuid())
  date      DateTime           @db.Date
  userId    String
  status    AvailabilityStatus
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@map("availabilities")
}

// A DM's confirmation that a campaign is playing on a given eligible day. Soft
// delete only: cancelling a session stamps `cancelledAt`/`cancelledById` and
// never removes the row, so cancelled attempts stay available for the Phase 2
// statistics view. Named `ConfirmedSession`
// (not `Session`) to avoid colliding with the Auth.js session table.
model ConfirmedSession {
  id              String    @id @default(cuid())
  campaignId      String
  date            DateTime  @db.Date
  // Mirrors `date` while the session is active, and is set to null on cancel.
  // Exists solely to back @@unique([campaignId, activeDate]): MySQL treats NULLs
  // as distinct, so any number of cancelled rows can coexist while at most one
  // ACTIVE row per (campaign, date) is possible. Never read for business logic.
  activeDate      DateTime? @db.Date
  // "HH:MM", local wall time — no timezone math lives in the DB.
  startTime       String?   @db.VarChar(5)
  // Only meaningful together with startTime. No startTime means an all-day session.
  durationMinutes Int?
  // True when the campaign was not viable on `date` (neither S nor O) at confirmation
  // time (a DM override, roadmap #22). Internal only — statistics/history — a forced
  // session looks identical in the UI.
  forced          Boolean   @default(false)

  confirmedById String
  cancelledAt   DateTime?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign       Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  confirmedBy    User                       @relation("SessionConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy    User?                      @relation("SessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  attendees      ConfirmedSessionAttendee[]
  diceEvents     DiceEvent[]

  @@unique([campaignId, activeDate])
  @@index([campaignId, date])
  // Both existing indexes lead with `campaignId`, but the hottest read filters
  // on the date alone: the shared-attendee conflict check, which runs on every
  // session confirmation and every attendee added. Cancelling is a soft delete,
  // so this table only ever grows.
  @@index([date])
  @@map("confirmed_sessions")
}

// Who actually plays a given confirmed session. In roadmap #21 this always
// mirrors the campaign's full membership (confirming a viable day means
// everyone plays); #22 makes the set vary via DM overrides and self-joins.
model ConfirmedSessionAttendee {
  sessionId String
  userId    String
  // Audit: the DM who added them, or null for the implicit whole-campaign set
  // written at confirmation (and later, a player's own self-join in #22).
  addedById String?
  createdAt DateTime @default(now())

  session ConfirmedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation("SessionAttendee", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?            @relation("SessionAttendeeAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([sessionId, userId])
  @@map("confirmed_session_attendees")
}

// A narrative arc of a campaign ("Arco 1"). Only used to group the critical/
// fumble log; a campaign without arcs simply records events with no arc.
model CampaignArc {
  id         String   @id @default(cuid())
  campaignId String
  // Order within the campaign, 1-based. Unique per campaign.
  number     Int
  name       String?  @db.VarChar(80)
  createdAt  DateTime @default(now())

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  diceEvents DiceEvent[]

  @@unique([campaignId, number])
  @@map("campaign_arcs")
}

enum DiceEventKind {
  CRITICAL
  FUMBLE
}

// A tabletop system (Pathfinder 2e, Vampire...). Loaded from prisma/catalog/*.json
// by `prisma/syncCatalog.ts`; never edited from the app.
model RoleSystem {
  id     String  @id @default(cuid())
  // Stable slug, the JSON file's key (e.g. "pathfinder-2e").
  key    String  @unique @db.VarChar(40)
  name   String  @db.VarChar(80)
  // False once the system's file is gone: it stops being offered, but the
  // campaigns and entries that use it keep working.
  active Boolean @default(true)

  campaigns Campaign[]
  skills    SystemSkill[]

  @@map("role_systems")
}

enum SkillCategory {
  SKILL
  CONDITION
}

// One closed-list entry of a system: a skill ("Percepción") or a condition
// ("A punto de morir"). Dice events point at it by id, so the statistics can
// group on it ("most criticals by skill", "times dying") without text clean-up.
model SystemSkill {
  id           String        @id @default(cuid())
  systemId     String
  // Stable, language-neutral key (e.g. "PERCEPTION", "DYING"); unique per system.
  key          String        @db.VarChar(40)
  category     SkillCategory
  nameEs       String        @db.VarChar(80)
  nameEn       String        @db.VarChar(80)
  // True for open-ended entries such as "Lore": an event may carry a short
  // `detail` ("Guild").
  allowsDetail Boolean       @default(false)
  // True for the "Custom" entries: the detail is then the whole point (what was
  // rolled), so it is mandatory. Implies `allowsDetail`.
  requiresDetail Boolean     @default(false)
  // Position within the system's file; the form lists entries in this order.
  sortOrder    Int           @default(0)
  // False once removed from the file: no longer offered, still valid for history.
  active       Boolean       @default(true)

  system     RoleSystem  @relation(fields: [systemId], references: [id], onDelete: Restrict)
  diceEvents DiceEvent[]

  @@unique([systemId, key])
  @@map("system_skills")
}

// One critical success or fumble a player rolled in a campaign. Its own event
// with a date: it only optionally links to a confirmed session, because the
// imported history predates the app and cannot be matched to one reliably.
model DiceEvent {
  id         String        @id @default(cuid())
  campaignId String
  // The player who rolled it. Must be a member of the campaign when created.
  userId     String
  kind       DiceEventKind
  // What was rolled: an entry of the campaign's system catalogue (checked by the
  // service: the FK cannot say "of the campaign's system").
  skillId    String
  // Short free text for entries that allow it (e.g. "Guild" for a Lore).
  detail     String?       @db.VarChar(60)
  date       DateTime      @db.Date
  // "HH:MM", local wall time of the roll. Past midnight it stays on the roll's
  // own date, it is not moved to the session's day.
  time       String?       @db.VarChar(5)
  arcId      String?
  sessionId  String?
  // Who typed it in (audit; any member may record for any member).
  createdById String
  // Idempotency key for imports (e.g. "excel:<player>:<campaign>:<cell>"); null
  // for events created in the app.
  importKey  String?       @unique @db.VarChar(120)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user      User              @relation("DiceEventPlayer", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User              @relation("DiceEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  arc       CampaignArc?      @relation(fields: [arcId], references: [id], onDelete: SetNull)
  session   ConfirmedSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  skill     SystemSkill       @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([campaignId, date])
  @@index([skillId])
  @@index([userId, campaignId])
  @@index([arcId])
  @@map("dice_events")
}

// A single-use, email-bound sign-up link (roadmap #24). Public registration is
// gone: the only way to create an account is accepting one of these. Only the
// SHA-256 hash of the raw token is ever stored — the raw value exists exactly
// once, in the HTTP response returned when the invitation is created, and is
// never persisted anywhere. `email` is always the account's email: the accept
// form never lets it be edited, so a forwarded link cannot be redirected to a
// different address.
model Invitation {
  id         String        @id @default(cuid())
  email      String
  tokenHash  String        @unique
  campaignId String?
  // Only meaningful together with campaignId — accepting then also creates the
  // CampaignPlayer row with this role. Validated as a pair (see
  // src/lib/validation/invitation.ts); not a DB-level CHECK, MySQL has none.
  role       CampaignRole?

  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@map("invitations")
}

// What happened to one "forgot password" request. Only SENT means a link was
// actually mailed; every other value is a request that produced no email.
enum PasswordResetOutcome {
  SENT
  UNKNOWN_EMAIL
  DISABLED_ACCOUNT
  RATE_LIMITED
  SEND_FAILED
}

// A single-use password reset link. Like `Invitation`, only the SHA-256 hash of
// the raw token is stored; the raw value exists once, in the email. Rows are
// pruned a day after they expire (see `prunePasswordResetData`).
model PasswordResetToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  // Set on the token that was redeemed.
  usedAt       DateTime?
  // Set when a newer link (or a completed reset) voided this one unused.
  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The prune deletes by expiry alone.
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Append-only audit trail of every "forgot password" request, whether or not
// the email exists (the screen answers identically either way, so this is the
// only place the difference is visible). `userId` is a loose scalar (no FK) and
// no token is ever stored here. Also what the rate limit counts. Kept 90 days.
model PasswordResetLog {
  id        String               @id @default(cuid())
  email     String               @db.VarChar(191)
  outcome   PasswordResetOutcome
  ipAddress String?              @db.VarChar(45)
  createdAt DateTime             @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
  @@map("password_reset_logs")
}

// ─── Auth.js v5 adapter tables ───────────────────────────────────────────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  // Declared as the primary key, not merely unique. Without one InnoDB builds a
  // hidden clustered index of its own — and this is the table with no bound on
  // its growth: Auth.js never deletes a row, and a session that gets used now
  // and then slides its expiry forward indefinitely.
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The purge (`scripts/ops/purge-expired-sessions.sh`) filters on `expires`
  // alone, and had nothing to filter with.
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
