# ─── MySQL ────────────────────────────────────────────────────────────────────
# Credentials for the MySQL database service (used by docker-compose).
# Change all values before deploying to any non-local environment.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=dmuster
MYSQL_USER=dmuster
MYSQL_PASSWORD=change_me

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Database connection string consumed by Prisma ORM.
# Must match the MySQL credentials above.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# For local Docker Compose use "db" as host (name of the db service).
DATABASE_URL="mysql://dmuster:change_me@db:3306/dmuster"

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
# Secret used to sign and verify session tokens. At least 32 characters —
# the app refuses to start otherwise, which is what stops the placeholder below
# from ever reaching a running deployment.
# Generate with:  openssl rand -base64 32
#            or:  npx auth secret
AUTH_SECRET=change_me_secret
# Canonical base URL of the application. Required in production.
# In development Auth.js infers it automatically; can be left as-is.
AUTH_URL=http://localhost:3000

# ─── Application ──────────────────────────────────────────────────────────────
# Default locale for new users and unauthenticated pages.
# Accepted values: "es" (Spanish) | "en" (English)
DEFAULT_LOCALE=es
# IANA timezone confirmed sessions are interpreted in when synced to Google
# Calendar. Stored session times are timezone-less "HH:MM" wall-clock strings;
# this is what lets Google resolve the correct instant (DST included).
APP_TIMEZONE=Europe/Madrid

# ─── Google Calendar (optional) ────────────────────────────────────────────────
# Lets users connect their Google account from /profile so confirmed sessions
# are mirrored to their primary calendar (roadmap #23). Leave all three unset
# to disable the integration entirely — the app boots normally and the profile
# hides the section.
#
# Setup (console.cloud.google.com):
#   1. Create a project, then enable the "Google Calendar API"
#      (APIs & Services > Library).
#   2. OAuth consent screen > User Type "External"; add scope
#      https://www.googleapis.com/auth/calendar.events; add each player's
#      email under "Test users". The app stays in "Testing" status — this
#      scope is sensitive enough that "In production" requires Google's
#      verification review. Testing supports up to 100 test users, which is
#      enough for one group, but Google expires each refresh_token after 7
#      days in this mode — reconnecting from /profile when marked "broken"
#      is expected, not a bug.
#   3. Credentials > Create credentials > OAuth client ID > Web application.
#      Authorized redirect URIs must match GOOGLE_OAUTH_REDIRECT_URI below
#      character-for-character.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ─── Cron (optional) ────────────────────────────────────────────────────────────
# Shared secret for two optional sweepers, both disabled (404) when unset.
# Leave it empty to disable them; if you set it, it must be at least 32
# characters (openssl rand -base64 32) — it is the only thing guarding routes
# anyone able to reach the app can call.
#   - POST /api/cron/calendar-sync: retries failed Google Calendar session
#     syncs on a schedule. Manual retry from /profile still works without it.
#   - POST /api/cron/availability-reminders: daily check for users who still
#     have unanswered eligible days next month, creating/clearing their
#     "REVISAR CALENDARIO ROL" reminder event accordingly.
CRON_SECRET=

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Initial password (bcrypt-hashed before storing) assigned to every user
# created by the seed script. Only required when running "npx prisma db seed".
#
# Every seeded account gets this same password, so it is a single credential
# guarding all of them at once. It must be at least 12 characters, and the seed
# refuses the placeholder below verbatim — it is published in this file. Give
# each account its own password afterwards:
#   docker compose exec app npx tsx scripts/ops/rotatePasswords.ts --apply
SEED_DEFAULT_PASSWORD=change_me_seed
#
# The seed only runs against an empty database: over live data it rewrites
# campaign tags, membership roles and stored availability answers, and restores
# memberships that were removed on purpose. Set this to 1 to override, after
# taking a backup with scripts/ops/backup-db.sh.
# SEED_OVERWRITE_EXISTING_DATA=1

# ─── Internal (do not set locally) ────────────────────────────────────────────
# Set automatically by the Docker build stage to skip env validation, since
# real secrets are not available at build time. Leave unset in local/.env.
# SKIP_ENV_VALIDATION=1
