# ─── MySQL ────────────────────────────────────────────────────────────────────
# Credentials for the MySQL database service (used by docker-compose).
# Change all values before deploying to any non-local environment.
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=dmuster
MYSQL_USER=dmuster
MYSQL_PASSWORD=change_me

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Database connection string consumed by Prisma ORM.
# Must match the MySQL credentials above.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# For local Docker Compose use "db" as host (name of the db service).
DATABASE_URL="mysql://dmuster:change_me@db:3306/dmuster"

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
# Secret used to sign and verify session tokens. At least 32 characters —
# the app refuses to start otherwise, which is what stops the placeholder below
# from ever reaching a running deployment.
# Generate with:  openssl rand -base64 32
#            or:  npx auth secret
AUTH_SECRET=change_me_secret
# Canonical base URL of the application. Required in production.
# In development Auth.js infers it automatically; can be left as-is.
AUTH_URL=http://localhost:3000

# ─── Application ──────────────────────────────────────────────────────────────
# Default locale for new users and unauthenticated pages.
# Accepted values: "es" (Spanish) | "en" (English)
DEFAULT_LOCALE=es
# IANA timezone confirmed sessions are interpreted in. Stored session times are
# timezone-less "HH:MM" wall-clock strings; this is what lets the calendar feed
# (/api/calendar/<token>.ics) resolve the correct instant (DST included).
APP_TIMEZONE=Europe/Madrid

# ─── Mail / password recovery (optional) ────────────────────────────────────────
# SMTP relay used to send password-reset links. Leave SMTP_HOST and SMTP_FROM
# unset to disable recovery entirely: the login page hides the link and the
# recovery routes return 404. The link points at AUTH_URL, so set that correctly.
#   Gmail: smtp.gmail.com / 587 / SMTP_SECURE=false, with an app password.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS when offered (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to recipients, e.g. DMuster <no-reply@example.com>
SMTP_FROM=

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Bootstrap account and campaign created by "npx prisma db seed". Only required
# when running the seed, and it only runs against an empty database.
#
# Sign-up is invitation-only and only a DM can invite, so the seed creates one
# user as DM of one campaign; that user invites everyone else from /profile.
# The values live here, not in the source, so no personal data is committed.
SEED_USER_EMAIL=
SEED_USER_NAME=
# At least 12 characters; the placeholder below is refused verbatim — it is
# published in this file.
SEED_USER_PASSWORD=change_me_seed
SEED_CAMPAIGN_NAME=
# Two-letter chip label shown in the calendar (letters or digits, e.g. "AC").
SEED_CAMPAIGN_TAG=

# ─── Internal (do not set locally) ────────────────────────────────────────────
# Set automatically by the Docker build stage to skip env validation, since
# real secrets are not available at build time. Leave unset in local/.env.
# SKIP_ENV_VALIDATION=1
